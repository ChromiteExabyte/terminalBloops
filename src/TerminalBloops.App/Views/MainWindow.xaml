<Window x:Class="TerminalBloops.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Terminal Bloops" Width="860" Height="660" MinWidth="660" MinHeight="500" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}" Background="{DynamicResource AeroBackgroundBrush}" AutomationProperties.Name="Terminal Bloops history">
    <Window.Resources>
        <Style x:Key="GlassToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="35" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource GlassBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource GlassBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin" Value="0,14,0,5" />
        </Style>
        <Style x:Key="EventExpander" TargetType="Expander">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14">
                            <StackPanel>
                                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand" AutomationProperties.Name="{Binding Name}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="13" Padding="15,15">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="24" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" ContentTemplate="{Binding HeaderTemplate, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                                    <Path x:Name="Chevron" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" RenderTransformOrigin="0.5,0.5" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="Details" Visibility="Collapsed" Margin="16,0,16,17" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Details" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="25,20,25,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="43" Height="43" Margin="0,0,12,0">
                <Ellipse Fill="{DynamicResource OrbBrush}" Stroke="{DynamicResource GlassBorderBrush}" StrokeThickness="1" />
                <Ellipse Fill="{DynamicResource OrbHighlightBrush}" Width="33" Height="20" Margin="0,3,0,0" VerticalAlignment="Top" />
                <Path Data="M 11,15 L 17,21 L 11,27 M 22,27 L 31,27" Stroke="{DynamicResource OrbTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>
            <TextBlock Grid.Column="1" Text="Terminal Bloops" FontSize="23" FontWeight="Normal" VerticalAlignment="Center" />
            <ToggleButton x:Name="SearchToggle" Grid.Column="2" Style="{StaticResource GlassToggle}" Checked="SearchToggleChecked" ToolTip="Search and filters (Ctrl+F)" AutomationProperties.Name="Search and filters" Margin="0,0,5,0" VerticalAlignment="Center">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" />
            </ToggleButton>
            <ToggleButton x:Name="SettingsToggle" Grid.Column="3" Checked="SettingsToggleChecked" Style="{StaticResource GlassToggle}" ToolTip="Settings and recorder" AutomationProperties.Name="Settings and recorder" VerticalAlignment="Center">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" />
            </ToggleButton>
        </Grid>
        <Border x:Name="SearchDrawer" Grid.Row="1" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,0,0,12" Visibility="{Binding IsChecked, ElementName=SearchToggle, Converter={StaticResource EmptyVisibility}, ConverterParameter=Invert}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="10,8" AutomationProperties.Name="Search recorded activity" ToolTip="Search process names, paths, launchers, and initial commands" />
                    <TextBlock Text="Search history" Foreground="{DynamicResource FaintBrush}" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Search}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="144" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="BriefOnlyCheckBox" Content="_Brief only · ≤ 5 s" IsChecked="{Binding BriefOnly}" VerticalAlignment="Center" FontSize="11" />
                    <ComboBox x:Name="EvidenceFilterBox" Grid.Column="1" ItemsSource="{Binding EvidenceFilters}" SelectedItem="{Binding EvidenceFilter}" FontSize="11" AutomationProperties.Name="Window evidence filter" ToolTip="Window evidence" />
                </Grid>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <ListBox x:Name="HistoryList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Recorded activity" SelectionChanged="HistorySelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="AutomationProperties.Name">
                            <Setter.Value>
                                <MultiBinding StringFormat="{}{0}, {1}">
                                    <Binding Path="Name" />
                                    <Binding Path="EvidenceLabel" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Expander x:Name="EventExpander" Style="{StaticResource EventExpander}" IsExpanded="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="78" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name, Converter={StaticResource KnownText}}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding StartUtc, Converter={StaticResource LocalTime}}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0" ToolTip="{Binding StartUtc, Converter={StaticResource LocalTime}, ConverterParameter='ddd, MMM d yyyy · HH:mm:ss zzz'}" />
                                    <Border Grid.Column="2" Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="9" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DurationMs, Converter={StaticResource Duration}}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource AccentTextBrush}" />
                                    </Border>
                                </Grid>
                            </Expander.Header>
                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Border BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,12,0">
                                                <Run Text="via " Foreground="{DynamicResource MutedBrush}" />
                                                <Run Text="{Binding LauncherName, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding EvidenceLabel}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" ToolTip="{Binding Evidence, Converter={StaticResource EvidenceDescription}}" />
                                        </Grid>
                                        <TextBlock Text="Executable" Style="{StaticResource DetailLabel}" />
                                        <TextBox Text="{Binding Image, Converter={StaticResource KnownText}, Mode=OneWay}" Style="{StaticResource Readout}" AutomationProperties.Name="Executable path" />
                                        <Grid Margin="0,14,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Initial command" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Copy" Click="CopyCommandClick" Tag="{Binding ElementName=RowCopyStatus}" FontSize="10" Padding="8,3" ToolTip="Copy initial command" />
                                        </Grid>
                                        <TextBox Text="{Binding CommandLine, Converter={StaticResource KnownText}, Mode=OneWay}" Style="{StaticResource Readout}" AutomationProperties.Name="Initial command line" />
                                        <TextBlock x:Name="RowCopyStatus" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        <TextBlock Text="Launcher" Style="{StaticResource DetailLabel}" />
                                        <TextBox Text="{Binding ParentImage, Converter={StaticResource KnownText}, Mode=OneWay}" Style="{StaticResource Readout}" AutomationProperties.Name="Recorded launcher path" />
                                        <CheckBox Content="Mute cards from this launcher" FontSize="11" Margin="0,12,0,0" IsChecked="{Binding DataContext.SelectedLauncherMuted, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" IsEnabled="{Binding DataContext.CanMuteLauncher, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Mute this exact launcher path; history is still recorded" />
                                        <Expander Header="Parent chain" Margin="0,12,0,0" FontSize="11">
                                            <StackPanel>
                                                <TextBlock Text="No earlier ancestor records are available." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Visibility="{Binding DataContext.Ancestors.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EmptyVisibility}}" />
                                                <ItemsControl ItemsSource="{Binding DataContext.Ancestors, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1,0,0,0" Padding="10,0,0,11" Margin="2,0,0,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name, Converter={StaticResource KnownText}}" FontSize="11" FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding Image, Converter={StaticResource KnownText}, Mode=OneWay}" Style="{StaticResource Readout}" Margin="0,3,0,0" />
                                                                    <TextBlock Text="{Binding StartUtc, Converter={StaticResource LocalTime}, ConverterParameter='MMM d · HH:mm:ss.fff'}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="Recorded details" FontSize="11" Margin="0,3,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Evidence, Converter={StaticResource EvidenceDescription}}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,0" />
                                                <TextBlock Text="Started (local time)" Style="{StaticResource DetailLabel}" />
                                                <TextBox Text="{Binding StartUtc, Converter={StaticResource LocalTime}, ConverterParameter='ddd, MMM d yyyy · HH:mm:ss.fff zzz', Mode=OneWay}" Style="{StaticResource Readout}" />
                                                <TextBlock Text="Ended (local time)" Style="{StaticResource DetailLabel}" />
                                                <TextBox Text="{Binding EndUtc, Converter={StaticResource LocalTime}, ConverterParameter='ddd, MMM d yyyy · HH:mm:ss.fff zzz', Mode=OneWay}" Style="{StaticResource Readout}" />
                                                <TextBlock Text="Process ID" Style="{StaticResource DetailLabel}" />
                                                <TextBox Text="{Binding ProcessId, Mode=OneWay}" Style="{StaticResource Readout}" />
                                                <TextBlock Text="Process GUID" Style="{StaticResource DetailLabel}" />
                                                <TextBox Text="{Binding Id, Mode=OneWay}" Style="{StaticResource Readout}" />
                                                <TextBlock Text="User" Style="{StaticResource DetailLabel}" />
                                                <TextBox Text="{Binding User, Converter={StaticResource KnownText}, Mode=OneWay}" Style="{StaticResource Readout}" />
                                                <TextBlock Text="Window title" Style="{StaticResource DetailLabel}" />
                                                <TextBox Text="{Binding WindowTitle, Converter={StaticResource KnownText}, Mode=OneWay}" Style="{StaticResource Readout}" />
                                                <TextBlock Text="Classification" Style="{StaticResource DetailLabel}" />
                                                <TextBox Text="{Binding ClassificationReason, Converter={StaticResource KnownText}, Mode=OneWay}" Style="{StaticResource Readout}" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </Expander>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="{Binding Items.Count, Converter={StaticResource EmptyVisibility}}">
                <TextBlock Text="No matching activity" Foreground="{DynamicResource MutedBrush}" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <Button Content="Recorder" Click="RecorderClick" HorizontalAlignment="Center" FontSize="11" Padding="13,6" AutomationProperties.Name="Open recorder settings" />
            </StackPanel>
        </Grid>
        <Border x:Name="SettingsDrawer" Grid.Row="3" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,12,0,0" Visibility="{Binding IsChecked, ElementName=SettingsToggle, Converter={StaticResource EmptyVisibility}, ConverterParameter=Invert}">
            <ScrollViewer MaxHeight="195" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="Show _cards" IsChecked="{Binding NotificationsEnabled}" FontSize="11" />
                        <CheckBox Grid.Column="1" Content="Start at _login" IsChecked="{Binding StartAtLogin}" FontSize="11" />
                    </Grid>
                    <TextBlock Text="Recorder" Style="{StaticResource DetailLabel}" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" LineHeight="18" AutomationProperties.LiveSetting="Polite" />
                    <Button Content="Set up recorder" Click="SetupClick" HorizontalAlignment="Left" FontSize="11" Padding="10,6" Margin="0,10,0,0" />
                    <Expander x:Name="CaptureHealth" Header="Capture health" Margin="0,9,0,0" FontSize="11">
                        <ItemsControl ItemsSource="{Binding Notices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding AtUtc, Converter={StaticResource LocalTime}}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MutedBrush}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <TextBlock Text="Local history · 7-day retention" FontSize="10" Foreground="{DynamicResource FaintBrush}" Margin="0,9,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="4" Margin="2,11,2,0">
            <TextBlock Text="{Binding EventCount}" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>